<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= titulo %>
    </title>


    <!-- =====================================
         BOOTSTRAP
    ====================================== -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- ENLACE AL CSS -->

    <link
        rel="stylesheet"
        href="/css/estilos.css"
    >

</head>


<body>


    <!-- BARRA DE NAVEGACIÓN -->

    <%- include("partials/navbar") %>



    <!-- HERO PRINCIPAL -->

    <section class="hero">

        <div class="hero-contenido">

            <p class="hero-subtitulo">
                PESCA DEPORTIVA
            </p>


            <h1>
                MASTER FISHING
            </h1>


            <h2>
                Tu aventura comienza aquí
            </h2>


            <p class="hero-texto">

                Encuentra equipos, accesorios y todo lo
                necesario para disfrutar tus mejores
                jornadas de pesca deportiva.

            </p>


            <div class="hero-botones">

                <a
                    href="/productos"
                    class="boton-principal"
                >
                    Ver productos
                </a>


                <a
                    href="/nosotros"
                    class="boton-secundario"
                >
                    Conócenos
                </a>

            </div>

        </div>

    </section>



    <!-- CATEGORÍAS -->

    <section class="categorias">

        <div class="contenedor">

            <h2 class="titulo-seccion">
                CATEGORÍAS
            </h2>


            <p class="descripcion-seccion">

                Todo lo que necesitas para preparar
                tu próxima jornada de pesca.

            </p>



            <div class="row g-4 mt-3">


                <!-- CAÑAS -->

                <div class="col-md-4">

                    <div class="categoria-card">

                        <div class="categoria-icono">
                            CAÑAS
                        </div>


                        <h3>
                            Cañas de pesca
                        </h3>


                        <p>

                            Encuentra cañas para diferentes
                            modalidades y tipos de pesca.

                        </p>


                        <a
                            href="/productos"
                            class="categoria-link"
                        >
                            Ver productos
                        </a>

                    </div>

                </div>



                <!-- CARRETES -->

                <div class="col-md-4">

                    <div class="categoria-card">

                        <div class="categoria-icono">
                            CARRETES
                        </div>


                        <h3>
                            Carretes
                        </h3>


                        <p>

                            Equipos diseñados para ofrecer
                            precisión, resistencia y control.

                        </p>


                        <a
                            href="/productos"
                            class="categoria-link"
                        >
                            Ver productos
                        </a>

                    </div>

                </div>



                <!-- ACCESORIOS -->

                <div class="col-md-4">

                    <div class="categoria-card">

                        <div class="categoria-icono">
                            ACCESORIOS
                        </div>


                        <h3>
                            Accesorios
                        </h3>


                        <p>

                            Señuelos, líneas, anzuelos y
                            accesorios para complementar tu equipo.

                        </p>


                        <a
                            href="/productos"
                            class="categoria-link"
                        >
                            Ver productos
                        </a>

                    </div>

                </div>


            </div>

        </div>

    </section>



    <!-- FOOTER -->

    <footer>

        <p>
            © 2026 MASTER FISHING
        </p>


        <p>
            Pesca deportiva • Aventura • Naturaleza
        </p>

    </footer>



    <!-- JAVASCRIPT BOOTSTRAP -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>