<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Nosotros | MASTER FISHING
    </title>


    <!-- BOOTSTRAP -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- CSS -->

    <link
        rel="stylesheet"
        href="/css/estilos.css"
    >

</head>


<body>


    <!-- =====================================
         NAVBAR
    ====================================== -->

    <%- include("partials/navbar") %>



    <!-- =====================================
         ENCABEZADO
    ====================================== -->

    <section class="nosotros-header">

        <div class="contenedor">

            <p class="hero-subtitulo">
                MASTER FISHING
            </p>


            <h1>
                SOBRE NOSOTROS
            </h1>


            <p>
                Pasión por la pesca, aventura y naturaleza.
            </p>

        </div>

    </section>



    <!-- =====================================
         HISTORIA
    ====================================== -->

    <section class="nosotros-contenido">

        <div class="contenedor">

            <div class="row align-items-center g-5">


                <!-- TEXTO -->

                <div class="col-lg-6">

                    <span class="nosotros-etiqueta">
                        NUESTRA HISTORIA
                    </span>


                    <h2>
                        Una tienda creada para los
                        amantes de la pesca deportiva
                    </h2>


                    <p>
                        MASTER FISHING nace con el propósito
                        de ofrecer productos y accesorios
                        para personas que disfrutan la pesca
                        deportiva y las actividades al aire libre.
                    </p>


                    <p>
                        Nuestro objetivo es brindar una
                        experiencia sencilla para encontrar
                        equipos de pesca adecuados para cada
                        aventura.
                    </p>


                    <p>
                        Queremos convertirnos en un espacio
                        donde la pasión por la pesca se
                        encuentre con la tecnología,
                        la naturaleza y la aventura.
                    </p>

                </div>



                <!-- TARJETA -->

                <div class="col-lg-6">

                    <div class="nosotros-card">

                        <h3>
                            MASTER FISHING
                        </h3>


                        <p>
                            Pesca deportiva
                        </p>


                        <hr>


                        <div class="nosotros-dato">

                            <strong>
                                PASIÓN
                            </strong>

                            <span>
                                Por la pesca
                            </span>

                        </div>


                        <div class="nosotros-dato">

                            <strong>
                                AVENTURA
                            </strong>

                            <span>
                                Al aire libre
                            </span>

                        </div>


                        <div class="nosotros-dato">

                            <strong>
                                CALIDAD
                            </strong>

                            <span>
                                En nuestros productos
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- =====================================
         MISIÓN Y VISIÓN
    ====================================== -->

    <section class="mision-vision">

        <div class="contenedor">

            <div class="row g-4">


                <!-- MISIÓN -->

                <div class="col-md-6">

                    <div class="info-card">

                        <h2>
                            MISIÓN
                        </h2>


                        <p>
                            Ofrecer productos y accesorios
                            de pesca deportiva que permitan
                            a nuestros clientes disfrutar
                            sus actividades al aire libre
                            con confianza y comodidad.
                        </p>

                    </div>

                </div>



                <!-- VISIÓN -->

                <div class="col-md-6">

                    <div class="info-card">

                        <h2>
                            VISIÓN
                        </h2>


                        <p>
                            Construir una tienda especializada
                            reconocida por su variedad de
                            productos, atención al cliente y
                            pasión por la pesca deportiva.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- =====================================
         FOOTER
    ====================================== -->

    <footer>

        <p>
            © 2026 MASTER FISHING
        </p>


        <p>
            Pesca deportiva • Aventura • Naturaleza
        </p>

    </footer>



    <!-- BOOTSTRAP JS -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>