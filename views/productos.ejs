<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Productos | MASTER FISHING
    </title>


    <!-- BOOTSTRAP -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- NUESTRO CSS -->

    <link
        rel="stylesheet"
        href="/css/estilos.css"
    >

</head>


<body>


    <!-- =====================================
         BARRA DE NAVEGACIÓN
    ====================================== -->

    <%- include("partials/navbar") %>



    <!-- =====================================
         ENCABEZADO DE PRODUCTOS
    ====================================== -->

    <section class="productos-header">

        <div class="contenedor">

            <p class="hero-subtitulo">
                MASTER FISHING
            </p>


            <h1>
                NUESTROS PRODUCTOS
            </h1>


            <p>

                Encuentra el equipo necesario para
                disfrutar tus jornadas de pesca deportiva.

            </p>

        </div>

    </section>



    <!-- =====================================
         CATÁLOGO
    ====================================== -->

    <section class="catalogo">

    <div class="contenedor">

        <div class="row g-4">

            <% productos.forEach(producto => { %>

                <div class="col-md-6 col-lg-4">

                    <div class="producto-card">

                        <!-- IMAGEN -->

                        <div class="producto-imagen">

                            <span>
                                IMAGEN
                            </span>

                        </div>

                        <!-- INFORMACIÓN -->

                        <div class="producto-contenido">


                            <span class="producto-categoria">

                                <%= producto.categoria %>

                            </span>


                            <h2>

                                <%= producto.nombre %>

                            </h2>


                            <p>

                                <%= producto.descripcion %>

                            </p>



                            <!-- PRECIO -->

                            <div class="producto-footer">


                                <span class="precio">

                                    $<%= producto.precio.toLocaleString("es-CO") %>

                                </span>


                                <a
                                    href="#"
                                    class="boton-producto"
                                >

                                    Ver producto

                                </a>


                            </div>


                        </div>


                    </div>

                </div>


            <% }); %>

        </div>

    </div>

</section>



    <!-- =====================================
         FOOTER
    ====================================== -->

    <footer>

        <p>
            © 2026 MASTER FISHING
        </p>


        <p>
            Pesca deportiva • Aventura • Naturaleza
        </p>

    </footer>



    <!-- BOOTSTRAP JS -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>